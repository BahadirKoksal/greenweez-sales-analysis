-- statistics grouped by top-level category
SELECT
  category_1,
  COUNT(DISTINCT(orders_id)) AS nb_orders,
  COUNT(DISTINCT(products_id)) AS nb_products,
  COUNT(DISTINCT(customers_id)) AS nb_customers,
  SUM(turnover) AS sum_turnover,
  SUM(purchase_cost) AS sum_purchase_cost,
  SUM(qty) AS sum_qty
FROM course14.gwz_sales
GROUP BY category_1;

-- categories ranked by total revenue
SELECT
  category_1,
  COUNT(DISTINCT(orders_id)) AS nb_orders,
  COUNT(DISTINCT(products_id)) AS nb_products,
  COUNT(DISTINCT(customers_id)) AS nb_customers,
  SUM(turnover) AS sum_turnover,
  SUM(purchase_cost) AS sum_purchase_cost,
  SUM(qty) AS sum_qty
FROM course14.gwz_sales
GROUP BY category_1
ORDER BY sum_turnover DESC;

-- top revenue category only
-- finding: Bébé & Enfant is #1 with ~€3,258,352
SELECT
  category_1,
  SUM(turnover) AS sum_turnover
FROM course14.gwz_sales
GROUP BY category_1
ORDER BY sum_turnover DESC
LIMIT 1;
